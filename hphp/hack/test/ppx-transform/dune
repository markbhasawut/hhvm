(executable
 (name pp)
 (modules pp)
 (libraries ppx_transform ppxlib))

(rule
 (targets test.actual.ml)
 (deps
  (:pp pp.exe)
  (:input test.ml)
  %{project_root}/hack/.ocamlformat)
 (action
   (progn
     (with-stdout-to %{targets} (run ./%{pp} --impl %{input} -o %{targets}))
     (bash "if command -v arc >/dev/null 2>&1; then arc f %{targets} >/dev/null 2>&1; else ocamlformat --inplace --enable-outside-detected-project %{targets}; fi")
   )
 )
)

(rule
 (alias runtest)
 (action
  (diff test.expected.ml test.actual.ml)))

(test
 (name test)
 (modules test)
 (preprocess
  (pps ppx_transform)))

(include dune.inc)
